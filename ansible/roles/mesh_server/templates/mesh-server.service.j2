[Unit]
Description=Mesh Proxy Hub Daemon
After=network.target rqlite.service

[Service]
ExecStart=/usr/local/bin/mesh-server --socket {{ socket_path }}
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
LimitNOFILE=65535
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/mesh-server

[Install]
WantedBy=multi-user.target

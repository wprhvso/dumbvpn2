[Unit]
Description=Mesh Proxy Hub Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mesh-server --port {{ mesh_server_port }}
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
